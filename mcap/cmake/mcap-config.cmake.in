@PACKAGE_INIT@

if(@ENABLE_ZSTD@)
    find_package(zstd REQUIRED)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/mcap-targets.cmake")

if(TARGET @PROJECT_NAME@::@PROJECT_NAME@ AND NOT TARGET @PROJECT_NAME@)
    add_library(@PROJECT_NAME@ ALIAS @PROJECT_NAME@::@PROJECT_NAME@)
endif()
